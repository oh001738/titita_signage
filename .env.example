# Copy to .env.local; generate local credentials using npm run setup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Use true behind an HTTPS reverse proxy; local HTTP preview uses false.
COOKIE_SECURE=true
# file is for local demo only; production must use mongo and a separate CMS database.
CMS_STORAGE=mongo
MONGODB_URI=mongodb://mongo:27017/titita_signage
DATA_DIR=/app/data
MOCK_MODE=false
MAIN_SYSTEM_URL=http://titita-onecloud:3000
SIGNAGE_API_KEY=
# Public origin behind reverse proxy (no trailing slash).
APP_ORIGIN=https://signage.example.com
